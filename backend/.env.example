# Postgres na nuvem (ex: Supabase, Neon, RDS...)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hackway

# Chave para assinar os JWT de autenticacao (gere uma string aleatoria longa)
SECRET_KEY=change-me-to-a-long-random-secret

# Chave Fernet para criptografia dos dados sensiveis dos alvos (endereco, descricao, notas).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Minutos de validade do token de acesso
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origem permitida para CORS. Ao rodar via docker-compose (com o proxy reverso
# nginx), front e API ficam na mesma origem publicada pelo nginx - use essa
# mesma origem aqui (ex: http://localhost:8080). Sem o proxy (frontend solto
# em npm run dev), use a origem do Next.js (ex: http://localhost:3000).
FRONTEND_ORIGIN=http://localhost:8080

# development | production
ENVIRONMENT=development
